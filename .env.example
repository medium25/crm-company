VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Для scripts/seed.js (npm run seed), не для браузера — существующий пользователь Firebase Auth
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Только для локальной разработки без настоящего Firebase-проекта.
# true — вход пропускается, useAuth() отдаёт фейкового staff с ролью VITE_DEV_BYPASS_ROLE.
# В деплое/проде — не ставить.
VITE_DEV_BYPASS_AUTH=false
VITE_DEV_BYPASS_ROLE=ceo

# Мгновенное обновление колонки «Статус» в Google Sheets при смене
# funnelStage лида (см. src/lib/sheetsExportHook.js) — отдельный Web App
# деплой appsscript/SheetsExport.gs (не тот же URL, что LEADS_API у
# appsscript/Code.gs). Если не задан — hook просто не шлётся, статус
# досчитает минутный триггер exportOnce.
VITE_SHEETS_EXPORT_HOOK_URL=
# Должен совпадать с EXPORT_HOOK_SECRET в Script Properties SheetsExport.gs.
VITE_SHEETS_EXPORT_HOOK_SECRET=
