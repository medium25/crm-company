rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function staff()      { return get(/databases/$(db)/documents/staff/$(request.auth.uid)).data; }
    function role()       { return staff().role; }
    function branches()   { return staff().branchIds; }
    function inBranch(b)  { return b in branches(); }
    // ceo/manager/admin — равнозначные должности полного доступа.
    function isAdmin()    { return role() in ['ceo', 'manager', 'admin']; }
    function isTeacher()  { return role() == 'teacher'; }
    function teachesGroup(gid) {
      return isTeacher() &&
        get(/databases/$(db)/documents/groups/$(gid)).data.teacherId == staff().teacherId;
    }

    match /staff/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      // admin (в отличие от ceo/manager) может заводить и трогать только
      // учителей — не должен уметь назначать роль ceo/manager/admin себе
      // или кому-либо ещё. UI это же прячет (lib/roles.js), это отдельная,
      // непробиваемая через devtools проверка.
      allow create: if isAdmin() && (role() != 'admin' || request.resource.data.role == 'teacher');
      allow update: if isAdmin() && (role() != 'admin' || (resource.data.role == 'teacher' && request.resource.data.role == 'teacher'));
      allow delete: if isAdmin() && (role() != 'admin' || resource.data.role == 'teacher');
    }

    match /branches/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /courses/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /rooms/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /teachers/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /students/{id} {
      // read без isTeacher() — учитель не должен листать всю базу студентов,
      // ростер своей группы он видит через enrollments (широкое read ниже).
      allow read:   if isAdmin();
      allow create: if isAdmin() && inBranch(request.resource.data.branchId);
      allow update: if isAdmin() && inBranch(resource.data.branchId);
      // Жёсткое удаление — только для настоящих лидов (status=='lead',
      // ещё ни разу не было enrollment/оплаты — recomputeStudentAggregates
      // переводит status в trial/active/paused/left при первой записи в
      // группу, назад в 'lead' не возвращает). Реальных студентов с
      // историей платежей удалить нельзя, только архивировать.
      allow delete: if isAdmin() && inBranch(resource.data.branchId) && resource.data.status == 'lead';
    }

    match /groups/{id} {
      // read не по branchId — проверка «группа использует курс/учителя/
      // кабинет» перед архивацией фильтрует по courseId/teacherId/roomId,
      // тот же случай, что enrollments/lessons выше.
      allow read:  if request.auth != null;
      allow write: if isAdmin() && inBranch(request.resource.data.branchId);
    }

    match /lessons/{id} {
      // read не по branchId — сетка посещаемости фильтрует по groupId,
      // тот же случай, что и enrollments выше.
      allow read:  if request.auth != null;
      allow write: if isAdmin() || teachesGroup(request.resource.data.groupId);

      match /attendance/{studentId} {
        allow read:  if request.auth != null;
        allow write: if isAdmin() ||
          teachesGroup(get(/databases/$(db)/documents/lessons/$(id)).data.groupId);
      }
    }

    // Отдельное правило для collectionGroup('attendance') — вложенное правило
    // выше действует только для прямого пути /lessons/{id}/attendance/{sid},
    // Firestore не применяет его к collection-group запросам (AttendanceTab,
    // reports.js фильтруют по groupId+month через collectionGroup).
    match /{path=**}/attendance/{studentId} {
      allow read: if request.auth != null;
    }

    match /transactions/{id} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin();
      // updateTransaction правит только сумму/комментарий/дату/месяц записи
      // на месте (без компенсирующих проводок).
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'comment', 'date', 'month', 'updatedAt', 'updatedBy']);
    }

    match /enrollments/{id} {
      // read не по branchId — код фильтрует по studentId/groupId (карточка
      // студента/группы, пересчёт агрегатов), Firestore не может статически
      // доказать branchId-скоуп для таких запросов и блокирует их целиком.
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    match /monthlyBalances/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /monthlyRevenue/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /billingRuns/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    match /comments/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    match /activityLog/{id} {
      allow read:  if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /callLogs/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /smsLogs/{id} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    match /grades/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    match /exams/{id} {
      allow read:  if request.auth != null;
      allow write: if isAdmin() || isTeacher();
    }

    match /tasks/{id} {
      allow read, write: if isAdmin();
    }

    // Ключи внешнего API (Apps Script → Firestore REST, приём лидов из
    // Google Sheets). Читает/пишет только scripts/manage-api-keys.mjs от
    // имени staff-администратора; сам Apps Script ходит в Firestore под
    // отдельным сервис-аккаунтом, который эти правила не проверяют — они
    // нужны только чтобы клиентский SDK (админка/скрипты) не мог читать
    // чужие хэши без прав. Сырое значение ключа в Firestore не хранится,
    // только sha256-хэш (см. API.md).
    match /apiKeys/{id} {
      allow read, write: if isAdmin();
    }
  }
}
